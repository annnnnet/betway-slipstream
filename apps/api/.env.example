# --- Betway Nigeria upstream -------------------------------------------------
# Public, unauthenticated endpoints. Overridable so the suite can be pointed at
# a recorded fixture server, and so a different Betway Africa country can be
# targeted without a code change.
BETWAY_BETTING_URL=https://www.betway.com.ng/appsynapse/bet-api-sr/v1
BETWAY_SPORTS_URL=https://www.betway.com.ng/sportsapi/br
BETWAY_SITE_URL=https://www.betway.com.ng
BETWAY_COUNTRY_CODE=NG
BETWAY_CULTURE_CODE=en-US

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/db?pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/db

# --- Supabase auth (optional sign-in; the app works signed-out) --------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# --- Server ------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
PORT=4000
